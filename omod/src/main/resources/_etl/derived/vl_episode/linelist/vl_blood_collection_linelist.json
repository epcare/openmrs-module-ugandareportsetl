    "type": "SQL",
    "name": "VL Episode Patients",
    "config": {
      "sql": "SELECT DISTINCT vl.patient_id FROM mamba_fact_viral_load_episode vl WHERE vl.sample_collection_date BETWEEN :startDate AND :endDate    OR vl.order_date BETWEEN :startDate AND :endDate;"
    }
