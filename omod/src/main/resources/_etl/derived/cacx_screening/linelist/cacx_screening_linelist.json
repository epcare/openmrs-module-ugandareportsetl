{
  "name": "CACx Screening Linelist",
  "description": "Line list of women of childbearing age (15-49 years) screened for Cervical Cancer",
  "report_type": "LINE_LIST",
  "section": "1B",
  "parameters": [
    {
      "name": "startDate",
      "label": "Start Date",
      "type": "DATE",
      "required": true
    },
    {
      "name": "endDate",
      "label": "End Date",
      "type": "DATE",
      "required": true
    }
  ],
  "baseCohortDefinition": {
    "type": "SQL",
    "name": "CACx Screened Women of Childbearing Age",
    "config": {
      "sql": "SELECT DISTINCT cs.client_id FROM mamba_fact_encounter_cacx_screening cs JOIN mamba_fact_patients_latest_patient_demographics pd ON pd.client_id = cs.client_id WHERE pd.gender = 'F' AND pd.age BETWEEN 15 AND 49 AND pd.dead = 0 AND cs.encounter_date BETWEEN :startDate AND :endDate"
    }
  },
